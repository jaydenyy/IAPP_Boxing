.exo-2-uniquifier {
  font-family: "Exo 2", sans-serif;
  font-optical-sizing: auto;
  font-weight: 400;
  font-style: normal;
}

* {
    margin: 0px;
    padding: 0px;
    box-sizing: border-box;
    font-family: "Exo 2", sans-serif;
}

body {
    background: #0D0D0D;
    color: #FFFFFF;
}

.contact-hero {
    text-align: center;
    padding: 60px 20px 40px;
}

.contact-hero .display {
    color: #E1261C;
    font-size: 2.8rem;
    letter-spacing: 2px;
    margin-bottom: 15px;
}

.contact-hero p {
    color: #BDBDBD;
    font-size: 1.1rem;
}

.contact-content {
    padding: 20px 30px 80px;
}

.contact-grid {
    display: flex;
    gap: 30px;
    max-width: 1100px;
    margin: 0 auto;
    flex-wrap: wrap;
}

.contact-card {
    background: #1A1A1A;
    border: 1px solid #2D2D2D;
    border-radius: 10px;
    padding: 30px;
    flex: 1;
    min-width: 300px;
}

.contact-card h3 {
    color: #E1261C;
    margin-bottom: 20px;
    font-size: 1.4rem;
}

.contact-item {
    color: #BDBDBD;
    margin-bottom: 20px;
    line-height: 1.6;
}

.contact-item strong {
    color: #FFFFFF;
}

.contact-form {
    display: flex;
    flex-direction: column;
}

.contact-form label {
    color: #BDBDBD;
    margin-bottom: 6px;
    margin-top: 14px;
    font-size: 0.9rem;
}

.contact-form label:first-child {
    margin-top: 0;
}

.contact-form input,
.contact-form textarea {
    background: #0D0D0D;
    border: 1px solid #2D2D2D;
    border-radius: 6px;
    padding: 12px 14px;
    color: #FFFFFF;
    font-size: 0.95rem;
    resize: vertical;
}

.contact-form input:focus,
.contact-form textarea:focus {
    outline: none;
    border-color: #E1261C;
}

.contact-form input::placeholder,
.contact-form textarea::placeholder {
    color: #6E6E6E;
}

.submit-btn {
    margin-top: 24px;
    background: #E1261C;
    color: #FFFFFF;
    border: none;
    padding: 14px;
    border-radius: 6px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s ease;
}

.submit-btn:hover {
    background: #b81e16;
}

@media (max-width: 700px) {
    .contact-grid {
        flex-direction: column;
    }
}